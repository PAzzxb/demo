    "线路数组": "swiper-slide ewave-tab\"&&</li>",
    // 提取线路名称（在<a>标签内）
    "线路标题": ">&&</a>",
    // 定位当前线路的播放列表容器（id="ewave-playlist-1"的ul）
    "播放数组": "id=\"ewave-playlist-1\"&&</ul>",
    // 定位每个剧集项（每个<li>）
    "播放列表": "<li&&</li>",
    // 提取单集标题（在<a>标签内，如“HD国语”）
    "播放标题": ">&&</a>",

    // ========== 分类与筛选（保持您原有结构，ID已确认） ==========
