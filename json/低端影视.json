    "导演": "导演：</span>&&&nbsp;",  // 导演姓名在“导演：</span>”和“&nbsp;”之间
    "主演": "演员：</span>&&&nbsp;",  // 主演列表
    "影片状态": "状态：</span>&&</em>",  // 如“HD国语|粤语”
    "影片类型": "类型：</span>&&&nbsp;",  // 如“恐怖片 恐怖”
    "影片地区": "地区：</span>&&&nbsp;",
    "影片年代": "年份：</span>&&&nbsp;",

    // ========== 列表页提取规则（基于通用class） ==========
    // 注意：此部分来自您提供的示例，但已根据该站通用模板调整
    "数组": "myui-vodlist__thumb lazyload\"&&</a>",
    "标题": "title=\"&&\"",
    "副标题": "pic-text text-right\"&&</span>",
    "图片": "data-original=\"&&\"",
    "链接": "href=\"&&\"",

    // ========== 搜索配置（保持通用） ==========
    "搜索url": "/vodsearch/-------------.html?wd={wd}",
    "搜索数组": "myui-vodlist__thumb&&</a>",
    "搜索标题": "title=\"&&\"",
    "搜索副标题": "pic-text text-right\">&&</span>",
    "搜索图片": "data-original=\"&&\"",
    "搜索链接": "href=\"&&\"",

    // ========== 播放页配置（根据您提供的HTML精准编写） ==========
